<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="exercicio7.AluguelController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Aluguel de carro">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Label text="Diária de R$ 100,00 com 100 km livres por dia. Cada km acima do limite custa R$ 0,50." wrapText="true" />
      <TextField fx:id="txtDias" maxWidth="300.0" promptText="Quantidade de dias" />
      <TextField fx:id="txtKm" maxWidth="300.0" promptText="Quilometragem percorrida (km)" />
      <Button defaultButton="true" onAction="#calcular" text="Calcular" />
      <TextArea fx:id="resultado" editable="false" prefRowCount="10" />
   </children>
</VBox>
