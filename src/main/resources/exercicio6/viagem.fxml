<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="exercicio6.ViagemController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Calculadora de viagem">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Label text="Calcula o gasto de combustível considerando 12 km/L. Viagens acima de 500 km têm 5% de desconto." wrapText="true" />
      <TextField fx:id="txtDistancia" maxWidth="300.0" promptText="Distância da viagem (km)" />
      <TextField fx:id="txtPreco" maxWidth="300.0" promptText="Preço do combustível (R$/L)" />
      <Button defaultButton="true" onAction="#calcular" text="Calcular" />
      <TextArea fx:id="resultado" editable="false" prefRowCount="10" />
   </children>
</VBox>
