<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="exercicio5.CamelosController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Os trinta e cinco camelos">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Label text="Informe a quantidade de camelos e quanto cada pessoa recebe (o denominador da fração). Ex.: 35 camelos e as parcelas 2 3 9." wrapText="true" />
      <TextField fx:id="txtCamelos" maxWidth="300.0" promptText="Quantidade de camelos" />
      <TextField fx:id="txtParcelas" maxWidth="300.0" promptText="Parcelas, ex.: 2 3 9" />
      <Button defaultButton="true" onAction="#calcular" text="Calcular" />
      <TextArea fx:id="resultado" editable="false" prefRowCount="10" />
   </children>
</VBox>
