<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="exercicio1.MultiploController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Verificação de Múltiplo">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Label text="Informe dois números inteiros para verificar se um é múltiplo do outro." wrapText="true" />
      <TextField fx:id="txtNumero1" maxWidth="300.0" promptText="Número 1" />
      <TextField fx:id="txtNumero2" maxWidth="300.0" promptText="Número 2" />
      <Button defaultButton="true" onAction="#calcular" text="Calcular" />
      <TextArea fx:id="resultado" editable="false" prefRowCount="10" />
   </children>
</VBox>
