<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="exercicio9.MeioAmbienteController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Meio ambiente">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Label text="Informe o nome da árvore, a quantidade de folhas e o tipo de solo." wrapText="true" />
      <TextField fx:id="txtArvore" maxWidth="300.0" promptText="Nome da árvore" />
      <TextField fx:id="txtFolhas" maxWidth="300.0" promptText="Quantidade de folhas" />
      <TextField fx:id="txtSolo" maxWidth="300.0" promptText="Tipo de solo" />
      <Button defaultButton="true" onAction="#calcular" text="Cadastrar" />
      <TextArea fx:id="resultado" editable="false" prefRowCount="10" />
   </children>
</VBox>
